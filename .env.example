# ==============================================================================
#  复制为 .env 后按需修改：cp .env.example .env
#  所有变量在 docker-compose.yml 里都有默认值。
# ==============================================================================

# ---- 决策服务：chinese-decision 仓库的推理服务（GPU：scripts/serve_gpu.py；CPU：scripts/serve.py）
DECISION_BASE_URL=http://gpu-server.example.com:8003
DECISION_TIMEOUT=120
# 协议：chinese-decision（自部署，支持 batch/compile/tournament）
#       startlux（Bamboo Relay 远端；只提供 /v1/systemone，平台会自动扇出 batch、客户端分组 tournament）
DECISION_API_STYLE=chinese-decision
# startlux 协议使用；chinese-decision 协议留空即可
DECISION_API_KEY=
DECISION_MODEL=startlux-decision-27b-autothink
DECISION_THINK_MODE=auto
DECISION_CONCURRENCY=4
# 热更新检查点用的令牌，与 GPU 服务器部署目录下的 .admin-token 的内容一致；留空 = 平台里不显示热更新按钮（CPU 服务不支持热更新）
DECISION_ADMIN_TOKEN=

# ---- MCP：挂在 /api/mcp/ 下，供 Claude Code / Cursor 等 MCP 客户端调用
MCP_ENABLED=true
# Host 白名单；默认只允许本机。部署到域名时改成 example.com,example.com:*（或 "*" 关闭校验，仅限反代已校验 Host）
MCP_ALLOWED_HOSTS=localhost,localhost:*,127.0.0.1,127.0.0.1:*,[::1],[::1]:*
# 浏览器里的 MCP 客户端才需要填，例如 https://studio.example.com
MCP_ALLOWED_ORIGINS=
# 留空 = 不鉴权；设置后客户端要带 Authorization: Bearer <token>
MCP_AUTH_TOKEN=
MCP_MAX_REQUEST_MB=32

# ---- 对照大模型：任意 OpenAI 兼容端点；留空 = 不启用“决策模型 vs 大模型”对比
# vLLM（推荐，支持 logprobs，能拿到大模型在候选字母上的概率分布）：
#   LLM_BASE_URL=http://gpu-server.example.com:8002/v1
#   LLM_MODEL=Qwen3-32B
#   LLM_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}
# 云厂商 API：LLM_BASE_URL 填厂商的 OpenAI 兼容地址，LLM_API_KEY 填密钥，LLM_EXTRA_BODY 留空
LLM_BASE_URL=
LLM_API_KEY=EMPTY
LLM_MODEL=Qwen3-32B
LLM_EXTRA_BODY=
# 评测时对照大模型最多跑多少条决策、并发多少
LLM_EVAL_LIMIT=200
LLM_CONCURRENCY=8

# ---- 评测与压测（接 CPU 服务时把 EVAL_BATCH_SIZE 调到 16，避免单批超过 DECISION_TIMEOUT）
EVAL_BATCH_SIZE=64
BENCH_MAX_CONCURRENCY=256

# ---- Postgres（容器内连接串由 compose 拼好，这里只改账号；对外部署前务必改密码）
POSTGRES_USER=studio
POSTGRES_PASSWORD=studio
POSTGRES_DB=studio

# ---- 端口
FRONTEND_PORT=8080
# 下面两个只绑定在 127.0.0.1 上
BACKEND_PORT=8090
POSTGRES_PORT=5433
TZ=Asia/Shanghai

# ---- 国内网络加速（构建镜像时使用）
# PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
# NPM_REGISTRY=https://registry.npmmirror.com
